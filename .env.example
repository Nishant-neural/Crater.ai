# --- LLM provider ---
# Supported providers: anthropic, gemini. Add another adapter under backend/llm/provider.py
# without changing the agents or extraction services.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database (Product Brain metadata) ---
# SQLite is fine for local dev; swap for Postgres in a real pilot.
DATABASE_URL=sqlite:///./crater.db

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=crater_chunks

# --- Embeddings ---
# Any sentence-transformers model name, or point this at a hosted embedding API later.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- OCR ---
# Path to tesseract binary if not on PATH.
TESSERACT_CMD=tesseract

# Phase 8E task routing. Leave blank to fall back to the global provider/model.
# For Gemini-only deployments, set LLM_PROVIDER=gemini and choose task models as needed.
EXTRACTION_PROVIDER=gemini
EXTRACTION_MODEL=
INTEGRATION_PROVIDER=gemini
INTEGRATION_MODEL=
DIAGNOSIS_PROVIDER=gemini
DIAGNOSIS_MODEL=
RERANK_PROVIDER=gemini
RERANK_MODEL=
VISION_PROVIDER=gemini
VISION_MODEL=
EXPERT_PROVIDER=gemini
EXPERT_MODEL=
