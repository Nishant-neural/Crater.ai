# --- LLM provider ---
# Supported providers: anthropic, gemini, openrouter. Add another adapter under backend/llm/provider.py
# without changing the agents or extraction services.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a fallback when GEMINI_API_KEY is unset;
# GEMINI_API_KEY wins when both are set.
GEMINI_MODEL=gemini-2.5-flash-lite

# --- OpenRouter (fix5, 21 Nov 2026) ---
# Free key: create one at https://openrouter.ai (sign up, then Keys).
# Diagnosis + rerank default to OpenRouter because Gemini's free tier
# 503s on those calls; extraction / integration / vision / expert stay
# on Gemini (see the task-routing block below). The default model was
# verified live 21 Nov 2026: the brief's meta-llama/llama-3.3-70b-instruct:free
# is DELISTED (only the paid variant remains). Do not set a model id
# without checking GET https://openrouter.ai/api/v1/models first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Database (Product Brain metadata) ---
# SQLite is fine for local dev; swap for Postgres in a real pilot.
DATABASE_URL=sqlite:///./crater.db

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=crater_chunks

# --- Embeddings ---
# Any sentence-transformers model name, or point this at a hosted embedding API later.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- OCR ---
# Path to tesseract binary if not on PATH.
TESSERACT_CMD=tesseract

# Phase 8E task routing. Leave blank to fall back to the global provider/model.
# For Gemini-only deployments, set LLM_PROVIDER=gemini and choose task models as needed.
EXTRACTION_PROVIDER=gemini
EXTRACTION_MODEL=
INTEGRATION_PROVIDER=gemini
INTEGRATION_MODEL=
# Diagnosis + rerank now default to openrouter in code (fix5); these
# lines only override that. Set them to gemini to go back to Gemini.
DIAGNOSIS_PROVIDER=openrouter
DIAGNOSIS_MODEL=
RERANK_PROVIDER=openrouter
RERANK_MODEL=
VISION_PROVIDER=gemini
VISION_MODEL=
EXPERT_PROVIDER=gemini
EXPERT_MODEL=

# Large semantic chunks reduce Gemini extraction request count while preserving context.
CHUNK_SIZE_CHARS=12000
CHUNK_OVERLAP_CHARS=1000
CHUNK_MIN_CHARS=2500
CHUNK_MAX_CHARS=15000

# Gemini extraction rate safety. Keep below a 15 RPM project limit.
EXTRACTION_GEMINI_RPM=10
EXTRACTION_RATE_LIMIT_BACKOFF_SECONDS=5

# Large-manual ingestion: ~80k chars/request; 10 RPM targets under 250k TPM with output headroom.
VECTOR_INDEX_BATCH_SIZE=64
EXTRACTION_BATCH_SIZE=18
EXTRACTION_BATCH_MAX_CHARS=80000
